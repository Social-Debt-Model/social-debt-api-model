# =============================================================================
# Variables de Entorno - Social Debt API Model (FastAPI)
# =============================================================================

# Configuración General del Proyecto
PROJECT_NAME="Social Debt API Model"
API_V1_STR="/api/v1"

# Seguridad y Autenticación
# Clave estática para proteger los endpoints de la API (enviar en la cabecera 'X-API-Key')
API_SECRET_KEY="super_secret_social_debt_key"

# Proveedores de Inteligencia Artificial (LLM)
# Clave de OpenAI para la clasificación de Macrocausas (gpt-4o-mini)
OPENAI_API_KEY="sk-proj-tu-api-key-aqui"

# -----------------------------------------------------------------------------
# Variables de Plataforma de Despliegue (Coolify / Railway / Nixpacks)
# Opcionales para entorno local; requeridas en entornos PaaS que usen Nixpacks.
# -----------------------------------------------------------------------------
# PYTHON_VERSION=3.11
# NIXPACKS_NODE_VERSION=22
