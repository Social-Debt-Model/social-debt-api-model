    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/ontosocialdebt#AdministrativeCause -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#AdministrativeCause">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasAdministrativePreventiveStrategy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#AdministrativePStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Measures addressing structural, regulatory and policy issues to prevent or reduce the accumulation of social debt.</rdfs:comment>
        <rdfs:label xml:lang="en">Administrative cause</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#AdministrativeEffect -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#AdministrativeEffect">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasAdministrativeStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#generatesEffect"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Consequences that affect an organization’s structure, processes, culture or governance and that degrade the work environment.</rdfs:comment>
        <rdfs:label xml:lang="en">AdministrativeEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#AdministrativePStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#AdministrativePStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesAdministrativeCause"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeCause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Preventive actions designed to address structural or bureaucratic issues that contribute to organizational inefficiency and social debt.</rdfs:comment>
        <rdfs:label xml:lang="en">AdministrativePStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#AdministrativeStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#AdministrativeStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#CorrectiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesAdministrativeEffect"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeEffect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Measures addressing structural, regulatory and policy issues to prevent or reduce the accumulation of social debt.</rdfs:comment>
        <rdfs:label xml:lang="en">AdministrativeStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Cause -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Cause">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#generatesCause"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#generatesEffect"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isAddressedByStrategy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isAssociatedWithGroup"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isIndicatedByCause"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Indicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isLinkedToPerson"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isMeasuredByMetric"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Metric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isPresentInOrganization"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Organization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#leadsToRisk"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
    A factor or condition that gives rise to a problem, conflict or deviation from expected objectives in an organization. Such causes may be structural, human, technological or cultural in nature.
  </rdfs:comment>
        <rdfs:label>Cause</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CollaborationCause -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CollaborationCause">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasCollaborationStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#CollaborationStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
    Factors that hamper interaction, knowledge sharing and teamwork, creating isolation among members and impeding information flow, decision-making and mutual support in the development community.
  </rdfs:comment>
        <rdfs:label xml:lang="en">CollaborationCause</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CollaborationMode -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CollaborationMode">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isCollaborationOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A structural or procedural approach through which individuals or teams interact to coordinate tasks, exchange information, and achieve shared objectives. Collaboration modes vary based on communication channels, frequency, synchronization, and team distribution.</rdfs:comment>
        <rdfs:label xml:lang="en">CollaborationMode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CollaborationStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CollaborationStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesCollaborationCause"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#CollaborationCause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Activities aimed at strengthening teamwork by fostering synergy, trust and shared responsibility for common tasks.</rdfs:comment>
        <rdfs:label xml:lang="en">CollaborationStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CommunicationCause -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CommunicationCause">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasCommunicationStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#CommunicationStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
    Factors that hinder effective interaction among development-team members—arising from language barriers, cultural differences, inadequate channels or a lack of soft skills—directly affecting productivity, clarity of information transfer and the efficiency of task coordination and decision-making.
  </rdfs:comment>
        <rdfs:label xml:lang="en">CommunicationCause</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CommunicationStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CommunicationStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesCommunicationCause"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#CommunicationCause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Actions that improve information flow among team members to promote mutual understanding and reduce misunderstandings, isolation and linguistic or cultural barriers.</rdfs:comment>
        <rdfs:label xml:lang="en">CommunicationStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CongruenceCause -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CongruenceCause">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasCongruenceStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#CongruenceStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
    Misalignment among communication, coordination and cooperation factors, leading to gaps in overall coordination that can delay projects, compromise outcomes and, in extreme cases, cause project failure.
  </rdfs:comment>
        <rdfs:label xml:lang="en">CongruenceCause</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CongruenceStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CongruenceStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesCongruenceCause"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#CongruenceCause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Activities that align communication, coordination and cooperation to ensure appropriate task assignment and effective work coordination.</rdfs:comment>
        <rdfs:label xml:lang="en">CongruenceStrategy</rdfs:label>
        <rdfs:label xml:lang="en">Socio-technical Congruence Strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CoordinationCause -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CoordinationCause">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasCoordinationStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#CoordinationStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
    Factors that obstruct the effective synchronization of tasks, resources, responsibilities and timing within the development team, thereby disrupting workflow, introducing delays and creating social tension.
  </rdfs:comment>
        <rdfs:label xml:lang="en">CoordinationCause</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CoordinationStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CoordinationStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesCoordinationCause"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#CoordinationCause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Practices that achieve effective synchronization of tasks, roles and deliveries, ensuring smooth and timely coordination.</rdfs:comment>
        <rdfs:label xml:lang="en">CoordinationStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#CorrectiveStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#CorrectiveStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Strategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesEffect"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
        <rdfs:comment xml:lang="en">A set of actions aimed at resolving existing problems arising from team conflicts or lack of collaboration.</rdfs:comment>
        <rdfs:label xml:lang="en">CorrectiveStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Effect -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Effect">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasCorrectiveStrategy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#CorrectiveStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isEffectGeneratedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Positive or negative outcomes that result from human interactions, internal and external factors, and the organizational impact of decisions and actions.</rdfs:comment>
        <rdfs:label xml:lang="en">Effect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Group -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Group">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasCollaborationMode"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#CollaborationMode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasMember"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isAffectedByCause"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isGroupOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#OrganizationalUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isLocatedAt"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A social unit of two or more people who interact to achieve common objectives and should be managed on the basis of collective, not merely individual, behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">Group</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#GroupEffect -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#GroupEffect">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasGroupStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#GroupStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Impacts that weaken collaboration, trust and cohesion, leading to rework, turnover and the absence of shared standards that impede joint work.</rdfs:comment>
        <rdfs:label xml:lang="en">GroupEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#GroupStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#GroupStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#CorrectiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesGroupEffect"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#GroupEffect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Activities that build team cohesion, promote equitable workload distribution, foster trust and consolidate a shared culture.</rdfs:comment>
        <rdfs:label xml:lang="en">GroupStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Indicator -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Indicator">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasMeasurement"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#MeasurementProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isSupportedByMetric"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Metric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#indicatesCause"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#indicatesRisk"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A quantitative or qualitative variable that provides relevant information about the state, performance or evolution of a process, phenomenon or entity.</rdfs:comment>
        <rdfs:label xml:lang="en">Indicator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#IndividualEffect -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#IndividualEffect">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasIndividualStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#IndividualStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Psychosocial or job-related consequences for a single team member—e.g., lack of recognition, work overload, isolation or poor communication.</rdfs:comment>
        <rdfs:label xml:lang="en">IndividualEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#IndividualStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#IndividualStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#CorrectiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesIndividualEffect"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#IndividualEffect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Activities that enhance technical and soft skills as well as the social, emotional and confidence-related well-being of team members.</rdfs:comment>
        <rdfs:label xml:lang="en">IndividualStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#IntervalScale -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#IntervalScale">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#ScaleType"/>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#LevelExperience -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#LevelExperience">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isExperienceLevelOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#PerformsRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The degree of knowledge, skill, time, depth and mastery acquired by a person through practice in a specific context.</rdfs:comment>
        <rdfs:label xml:lang="en">LevelExperience</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Location -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Location">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasGroupLocation"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The physical or virtual location where an individual, group or organizational unit performs its activities—particularly significant in distributed environments.</rdfs:comment>
        <rdfs:label xml:lang="en">Location</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Measure -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Measure">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isResultOfMeasurement"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#MeasurementProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.example.org/ontosocialdebt#MeasurementProcess"/>
        <rdfs:comment xml:lang="en">A numerical value obtained by directly observing or inferring a characteristic of an object or process; by itself it lacks complete meaning without contextual interpretation.</rdfs:comment>
        <rdfs:comment xml:lang="en">Measure is the value resulting from a measurement activity. It is not equivalent to the process or act of measuring.</rdfs:comment>
        <rdfs:label xml:lang="en">Measure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#MeasurementProcess -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#MeasurementProcess">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasMeasure"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Measure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isMeasurementOfIndicator"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Indicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isMeasurementProducedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Metric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Measurement refers to the act or process of taking a measurement, while Measure refers to the outcome or value obtained. These are conceptually distinct.</rdfs:comment>
        <rdfs:comment xml:lang="en">The process of assigning values or measures to characteristics, properties or attributes of an object or activity according to specific rules.</rdfs:comment>
        <rdfs:label xml:lang="en">MeasurementProcess</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Metric -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Metric">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#measuresCause"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#producesMeasurement"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#MeasurementProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#supportsIndicator"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Indicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#usesScale"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Scale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A function that converts one or more measures into an aggregated or interpreted value useful for decision-making or performance evaluation; metrics assess quality, productivity or risk.</rdfs:comment>
        <rdfs:label xml:lang="en">Metric</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#NominalScale -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#NominalScale">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#ScaleType"/>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#OrdinalScale -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#OrdinalScale">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#ScaleType"/>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Organization -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Organization">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasCause"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasSubOrganization"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Organization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasUnit"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#OrganizationalUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A social system in which people interact to achieve common objectives through a division of labour and a hierarchy of authority.</rdfs:comment>
        <rdfs:comment xml:lang="en">An entity composed of people and units, responsible for coordinating activities and resources.</rdfs:comment>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#OrganizationalUnit -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#OrganizationalUnit">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#belongsToOrganization"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Organization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasGroup"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasPerson"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Subdivision within an organization that groups employees, departments or specialised functions, enabling more efficient management and a clear allocation of responsibilities.</rdfs:comment>
        <rdfs:label xml:lang="en">OrganizationalUnit</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#PerformsRole -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#PerformsRole">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasExperienceLevel"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#LevelExperience"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasRolePerformance"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Role"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isPerformedRole"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Person"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A relationship in which a person performs a specific role in an organization, with a defined experience level.</rdfs:comment>
        <rdfs:label xml:lang="en">PerformsRole</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Person -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Person">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#belongsToUnit"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#OrganizationalUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isMemberOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#performsRole"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#PerformsRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An individual agent with cognitive, technical and social capabilities who fulfils one or more roles within the team or organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#PreventiveStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#PreventiveStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Strategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#addressesCause"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A set of planned actions that anticipate potential problems, risks or adverse effects in order to safeguard quality, performance or well-being within a system, process or organization.</rdfs:comment>
        <rdfs:label xml:lang="en">PreventiveStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#ProjectManagementEffect -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#ProjectManagementEffect">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasProjectManagementStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#ProjectManagementStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Negative consequences for planning, execution, monitoring, scope and control that stem from deficiencies in social relationships.</rdfs:comment>
        <rdfs:label xml:lang="en">ProjectManagementEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#ProjectManagementStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#ProjectManagementStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#CorrectiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesProjectManagementEffect"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#ProjectManagementEffect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Actions that facilitate project direction, planning, scope definition and monitoring, ensuring proper development aligned with organizational objectives</rdfs:comment>
        <rdfs:comment xml:lang="en">Actions that facilitate project direction, planning, scope definition and monitoring, ensuring proper development aligned with organizational objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">ProjectManagementStrategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#RatioScale -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#RatioScale">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#ScaleType"/>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Risk -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Risk">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isMonitoredByIndicator"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Indicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#leadsToRisk"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Risk"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A potential event with negative impact that could materialize in the future, jeopardising project or system objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Role -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Role">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isRolePerformanceOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#PerformsRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A description of the responsibilities, duties and skills required to perform a specific activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Scale -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Scale">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isUsedByMetric"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Metric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasScaleType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#ScaleType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An ordered set of values—continuous, discrete or categorical—assigned to an attribute to classify, measure and appraise an object or characteristic.</rdfs:comment>
        <rdfs:label xml:lang="en">Scale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#ScaleType -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#ScaleType">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#isTypeOfScale"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.example.org/ontosocialdebt#Scale"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A categorization of scale based on the nature of values and mathematical properties: nominal, ordinal, interval, or ratio.</rdfs:comment>
        <rdfs:label xml:lang="en">ScaleType</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#Strategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#Strategy">
        <rdfs:comment>Actions designed to achieve specific objectives through efficient resource allocation, taking account of the environment, internal capabilities and potential risks.</rdfs:comment>
        <rdfs:label>Strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#SubOrganization -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#SubOrganization">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Organization"/>
        <rdfs:comment xml:lang="en">The structural, legal or functional nature of an organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Sub Organization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#TechnicalEffect -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#TechnicalEffect">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#hasTechnicalStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#TechnicalStrategy"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Manifested in the deterioration of key product attributes such as maintainability, modularity, architectural integrity, reusability and efficiency.</rdfs:comment>
        <rdfs:label xml:lang="en">TechnicalEffect</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/ontosocialdebt#TechnicalStrategy -->

    <owl:Class rdf:about="http://www.example.org/ontosocialdebt#TechnicalStrategy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/ontosocialdebt#CorrectiveStrategy"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/ontosocialdebt#mitigatesTechnicalEffectStrategy"/>
                <owl:someValuesFrom rdf:resource="http://www.example.org/ontosocialdebt#TechnicalEffect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Planned activities that improve structural integrity, maintainability, performance and reliability to guarantee software technical quality.</rdfs:comment>
        <rdfs:label xml:lang="en">TechnicalStrategy</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/ontosocialdebt#ADM-002_LackOfDocumentation -->

    <owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#ADM-002_LackOfDocumentation">
        <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeCause"/>
        <generatesEffect rdf:resource="http://www.example.org/ontosocialdebt#AEF-004_LimitedResourceAccess"/>
        <generatesEffect rdf:resource="http://www.example.org/ontosocialdebt#PME-004_InefficientUseOfResources"/>
        <hasAdministrativePreventiveStrategy rdf:resource="http://www.example.org/ontosocialdebt#PS-004_DocumentationPolicyImplementation"/>
        <isAssociatedWithGroup rdf:resource="http://www.example.org/ontosocialdebt#GRP002_Evaluation_Team"/>
        <isIndicatedByCause rdf:resource="http://www.example.org/ontosocialdebt#IND-004_Responsibility_Overlap_Index"/>
        <isMeasuredByMetric rdf:resource="http://www.example.org/ontosocialdebt#MTR-001_Knowledge_Transfer_Efficiency"/>
        <isPresentInOrganization rdf:resource="http://www.example.org/ontosocialdebt#ORG-001-GSS"/>
        <leadsToRisk rdf:resource="http://www.example.org/ontosocialdebt#RSK-005_Documentation_Gaps_Risk"/>
        <hasCauseDescription>Lack of Documentation occurs when project, process, operational, or knowledge-sharing documentation is missing, incomplete, outdated, or inaccessible, making knowledge transfer, onboarding, and collaboration difficult.</hasCauseDescription>
        <hasCauseID>ADM-002</hasCauseID>
        <hasCauseName>Lack of Documentation</hasCauseName>
        <hasRelatedCommunitySmell>Truck Factor</hasRelatedCommunitySmell>
    </owl:NamedIndividual>
    


    <!-- http://www.example.org/ontosocialdebt#ADM-003_LackOfStandardsOrBestPractices -->

    <owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#ADM-003_LackOfStandardsOrBestPractices">
        <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeCause"/>
        <generatesEffect rdf:resource="http://www.example.org/ontosocialdebt#AEF-020_InconsistentDocumentationPractices"/>
        <hasAdministrativePreventiveStrategy rdf:resource="http://www.example.org/ontosocialdebt#PS-023_DefineDocumentationAndReviewStandards"/>
        <isIndicatedByCause rdf:resource="http://www.example.org/ontosocialdebt#IND-023_DocumentationStandardMentions"/>
        <isMeasuredByMetric rdf:resource="http://www.example.org/ontosocialdebt#MTR-023_DocumentationStandardCompliance"/>
        <isMonitoredByIndicator rdf:resource="http://www.example.org/ontosocialdebt#IND-023_DocumentationStandardMentions"/>
        <leadsToRisk rdf:resource="http://www.example.org/ontosocialdebt#RSK-023_KnowledgeFragmentationRisk"/>
        <hasCauseDescription>Lack of Standards or Best Practices occurs when contributors do not have agreed guidelines, conventions, procedures, coding standards, review practices, or governance criteria to guide consistent work.</hasCauseDescription>
        <hasCauseID>ADM-003</hasCauseID>
        <hasCauseName>Lack of standards or best practices</hasCauseName>
        <hasRelatedCommunitySmell>Missing Link</hasRelatedCommunitySmell>
        <hasRelatedCommunitySmell>Organizational Silo</hasRelatedCommunitySmell>
        <rdfs:label xml:lang="en">Knowledge, documentation, and standards deficiencies</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.example.org/ontosocialdebt#AEF-001_LackOfOrganizationalClarity -->

    <owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#AEF-001_LackOfOrganizationalClarity">
        <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeEffect"/>
        <hasAdministrativeStrategy rdf:resource="http://www.example.org/ontosocialdebt#STR-001_ClarifyOrgStructure"/>
        <hasAdministrativeStrategy rdf:resource="http://www.example.org/ontosocialdebt#STR-002_RoleDefinitionWorkshops"/>
        <hasEffectDescription>The absence of clear organizational vision and mission generates confusion and lack of alignment among team members.</hasEffectDescription>
        <hasEffectDetectionDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-16</hasEffectDetectionDate>
        <hasEffectID>AEF-001</hasEffectID>
        <hasEffectName>Lack of Clarity in Vision and Mission</hasEffectName>
    </owl:NamedIndividual>
    


    <!-- http://www.example.org/ontosocialdebt#AEF-002_InefficientStructure -->

    <owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#AEF-002_InefficientStructure">
        <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeEffect"/>
        <hasAdministrativeStrategy rdf:resource="http://www.example.org/ontosocialdebt#STR-003_RestructureTeams"/>
        <hasAdministrativeStrategy rdf:resource="http://www.example.org/ontosocialdebt#STR-004_ProcessOptimization"/>
