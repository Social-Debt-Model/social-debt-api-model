        <hasEffectName>Inefficiency in Resource Allocation</hasEffectName>
    </owl:NamedIndividual>
    


    <!-- http://www.example.org/ontosocialdebt#PME-002_PoorChangeManagement -->

    <owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#PME-002_PoorChangeManagement">
        <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#ProjectManagementEffect"/>
        <hasEffectDescription>Ineffective management of changes and priorities delays project delivery and increases team frustration.</hasEffectDescription>
        <hasEffectDetectionDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-14</hasEffectDetectionDate>
        <hasEffectID>PME-002</hasEffectID>
        <hasEffectName>Ineffective Change Management</hasEffectName>
    </owl:NamedIndividual>
    


    <!-- http://www.example.org/ontosocialdebt#PME-003_DelaysInTaskDelivery -->

    <owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#PME-003_DelaysInTaskDelivery">
        <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#ProjectManagementEffect"/>
        <hasCorrectiveStrategy rdf:resource="http://www.example.org/ontosocialdebt#CS-028_TaskDeliveryRecoveryPlan"/>
        <mitigatesEffect rdf:resource="http://www.example.org/ontosocialdebt#CS-002_ProcessImprovementActions"/>
        <hasEffectDescription>The delivery of tasks and projects is delayed due to poor knowledge distribution and lack of coordination.</hasEffectDescription>
        <hasEffectDetectionDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-14</hasEffectDetectionDate>
        <hasEffectID>PME-003</hasEffectID>
        <hasEffectName>Delays in Task Delivery</hasEffectName>
    </owl:NamedIndividual>
    


    <!-- http://www.example.org/ontosocialdebt#PME-004_InefficientTaskExecution -->

    <owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#PME-004_InefficientTaskExecution">
        <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
        <hasCorrectiveStrategy rdf:resource="http://www.example.org/ontosocialdebt#CS-032_TaskExecutionImprovement"/>
        <hasEffectDescription xml:lang="en">Reduced efficiency in task execution caused by unclear coordination, unresolved dependencies, inadequate tooling, or technical constraints that slow down development work.</hasEffectDescription>
        <hasEffectDescription xml:lang="en">Reduced efficiency in task execution due to unclear coordination, technical constraints, inadequate tooling, or unresolved dependencies that slow down development activities.</hasEffectDescription>
        <hasEffectName xml:lang="en">Inefficient task execution</hasEffectName>
    </owl:NamedIndividual>
    


