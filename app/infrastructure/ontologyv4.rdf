    <rdf:Description rdf:about="http://www.example.org/ontosocialdebt#IntervalScale">
        <rdfs:comment xml:lang="en">A scale with equal intervals between values, but without a true zero point; useful for attributes like temperature in Celsius.</rdfs:comment>
        <rdfs:label xml:lang="en">Interval Scale</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.example.org/ontosocialdebt#NominalScale">
        <rdfs:comment xml:lang="en">A categorical scale that classifies data into distinct categories without any order—e.g., roles like developer, manager, tester.</rdfs:comment>
        <rdfs:label xml:lang="en">Nominal Scale</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.example.org/ontosocialdebt#OrdinalScale">
        <rdfs:comment xml:lang="en">A scale that arranges values in a ranked order without assuming equal intervals—e.g., satisfaction levels: low, medium, high.</rdfs:comment>
        <rdfs:label xml:lang="en">Ordinal Scale</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.example.org/ontosocialdebt#RatioScale">
        <rdfs:comment xml:lang="en">A quantitative scale with equal intervals and a true zero, allowing for comparisons of absolute magnitudes—e.g., lines of code, hours worked.</rdfs:comment>
        <rdfs:label xml:lang="en">Ratio Scale</rdfs:label>
    </rdf:Description>
