    <!-- http://www.example.org/ontosocialdebt#PME-006_MisalignedEfforts -->

    <owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#PME-006_MisalignedEfforts">
        <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#ProjectManagementEffect"/>
        <hasCorrectiveStrategy rdf:resource="http://www.example.org/ontosocialdebt#CS-029_EffortRealignmentReview"/>
        <hasProjectManagementStrategy rdf:resource="http://www.example.org/ontosocialdebt#CS-PM-006_EffortAlignmentRecovery"/>
        <hasEffectDescription>Team efforts are not aligned with project objectives due to a lack of planning and discussion.</hasEffectDescription>
        <hasEffectDetectionDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-06-14</hasEffectDetectionDate>
        <hasEffectID>PME-006</hasEffectID>
        <hasEffectName>Misaligned Team Efforts</hasEffectName>
