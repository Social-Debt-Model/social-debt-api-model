    <hasMetricID>MTR-021</hasMetricID>
    <hasMetricName>Compatibility Issue Frequency</hasMetricName>
    <hasMetricDescription>Frequency of comments, issues, or review discussions that mention compatibility constraints, backward compatibility concerns, version conflicts, platform-dependent behavior, or legacy compatibility requirements.</hasMetricDescription>
</owl:NamedIndividual>


