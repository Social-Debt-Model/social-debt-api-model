<!-- http://www.example.org/ontosocialdebt#COG-008_CompatibilityConstraints -->

<owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#COG-008_CompatibilityConstraints">
    <rdf:type rdf:resource="http://www.example.org/ontosocialdebt#CongruenceCause"/>
    <generatesEffect rdf:resource="http://www.example.org/ontosocialdebt#TEF-011_CompatibilityProblems"/>
    <generatesEffect rdf:resource="http://www.example.org/ontosocialdebt#TEF-021_CompatibilityFailure"/>
