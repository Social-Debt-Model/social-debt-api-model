    <isMonitoredByIndicator rdf:resource="http://www.example.org/ontosocialdebt#IND-021_CompatibilityMentions"/>
    <isMeasuredByMetric rdf:resource="http://www.example.org/ontosocialdebt#MTR-021_CompatibilityIssueFrequency"/>
    <leadsToRisk rdf:resource="http://www.example.org/ontosocialdebt#RSK-013_TechnicalMaintenanceRisk"/>
    <leadsToRisk rdf:resource="http://www.example.org/ontosocialdebt#RSK-021_BackwardCompatibilityRisk"/>
    <hasCauseDescription>Compatibility problems refer to difficulties, constraints, or potential inconsistencies that arise when software artifacts must remain compatible across versions, APIs, platforms, environments, or legacy behavior.</hasCauseDescription>
    <hasCauseID>COG-008</hasCauseID>
    <hasCauseName>Compatibility Constraints</hasCauseName>
    <hasRelatedCommunitySmell>Socio-Technical Congruence Gap</hasRelatedCommunitySmell>
    <rdfs:label xml:lang="en">Compatibility constraints</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://www.example.org/ontosocialdebt#MTR-021_CompatibilityIssueFrequency">
