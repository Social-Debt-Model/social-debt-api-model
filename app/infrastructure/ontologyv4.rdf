<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/ontosocialdebt#"
     xml:base="http://www.example.org/ontosocialdebt"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.example.org/ontosocialdebt">
        <dcterms:creator>César Jésus Pardo Calvache</dcterms:creator>
        <dcterms:creator>Eydy Suárez Brieva</dcterms:creator>
        <dcterms:creator>Ricardo Pérez Del Castillo</dcterms:creator>
        <dcterms:description>
      Social Debt Ontology is a formal and structured model that represents the key concepts, causes, effects, and mitigation strategies related to social debt in agile and distributed software development environments. The ontology aims to support the identification, analysis, management, and prevention of social debt within teams and organizations by linking it to indicators, metrics, risks, and community smells. It is designed for use in both academic research and practical applications in industry.
    </dcterms:description>
        <dcterms:language>en</dcterms:language>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-06-19</dcterms:modified>
        <dcterms:title>Social Debt Ontology</dcterms:title>
        <vann:preferredNamespacePrefix>sd</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="http://www.example.org/ontosocialdebt#"/>
        <owl:versionInfo>v1.0</owl:versionInfo>
    </owl:Ontology>
    


