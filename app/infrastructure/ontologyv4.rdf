    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.example.org/ontosocialdebt#addressesCause -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#addressesCause">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isAddressedByStrategy"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#PreventiveStrategy"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:comment xml:lang="en">Relates a preventive strategy to the cause it addresses.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a strategy to the cause it addresses.</rdfs:comment>
        <rdfs:label xml:lang="en">addresses cause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#belongsToOrganization -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#belongsToOrganization">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#hasUnit"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#OrganizationalUnit"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Organization"/>
        <rdfs:comment xml:lang="en">Indicates that an organizational unit is part of a higher-level organization.</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to organization</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#belongsToUnit -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#belongsToUnit">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#hasPerson"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#OrganizationalUnit"/>
        <rdfs:comment xml:lang="en">Links a person to their organizational unit.</rdfs:comment>
        <rdfs:label xml:lang="en">belongs to unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#generatesCause -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#generatesCause">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isGeneratedByCause"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:comment xml:lang="en">Establishes a relationship between two causes.</rdfs:comment>
        <rdfs:comment xml:lang="en">This property is not symmetric nor transitive. It represents a directed generative relationship between causes.</rdfs:comment>
        <rdfs:label xml:lang="en">generatesCause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#generatesEffect -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#generatesEffect">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isEffectGeneratedBy"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
        <rdfs:comment xml:lang="en">Indicates that a cause generates an effect.</rdfs:comment>
        <rdfs:label xml:lang="en">generates effect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasAdministrativePreventiveStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasAdministrativePreventiveStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesAdministrativeCause"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeCause"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#AdministrativePStrategy"/>
        <rdfs:comment xml:lang="en">Relates an administrative cause to its preventive strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has administrative preventive strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasAdministrativeStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasAdministrativeStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesAdministrativeEffect"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeEffect"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#AdministrativeStrategy"/>
        <rdfs:comment xml:lang="en">Relates an administrative effect to a corrective strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has administrative strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasCause -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasCause">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isPresentInOrganization"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Organization"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Cause"/>
        <rdfs:comment xml:lang="en">Relates an organization to a cause it has identified or is affected by.</rdfs:comment>
        <rdfs:label xml:lang="en">has cause</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasCollaborationMode -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasCollaborationMode">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isCollaborationOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#CollaborationMode"/>
        <rdfs:comment xml:lang="en">Relates a location to a collaboration mode used by the group.</rdfs:comment>
        <rdfs:label xml:lang="en">has collaboration mode</rdfs:label>
        <rdfs:label xml:lang="en">hascollaborationmode</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasCollaborationStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasCollaborationStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesCollaborationCause"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#CollaborationCause"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#CollaborationStrategy"/>
        <rdfs:comment xml:lang="en">Relates a collaboration-related cause to its corresponding strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has collaboration strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasCommunicationStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasCommunicationStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesCommunicationCause"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#CommunicationCause"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#CommunicationStrategy"/>
        <rdfs:comment xml:lang="en">Relates a communication-related cause to its corresponding preventive strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has communication strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasCongruenceStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasCongruenceStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesCongruenceCause"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#CongruenceCause"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#CongruenceStrategy"/>
        <rdfs:comment xml:lang="en">Relates a congruence-related cause to its associated preventive strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has congruence strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasCoordinationStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasCoordinationStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesCoordinationCause"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#CoordinationCause"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#CoordinationStrategy"/>
        <rdfs:comment xml:lang="en">Links a coordination-related cause with its preventive strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has coordination strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasCorrectiveStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasCorrectiveStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesEffect"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Effect"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#CorrectiveStrategy"/>
        <rdfs:comment xml:lang="en">
        Relates an Effect to a Corrective Strategy implemented to mitigate or resolve it.
    </rdfs:comment>
        <rdfs:label xml:lang="en">has corrective strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasExperienceLevel -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasExperienceLevel">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isExperienceLevelOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#PerformsRole"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#LevelExperience"/>
        <rdfs:comment xml:lang="en">Links a role performance to the level of experience required or exhibited.</rdfs:comment>
        <rdfs:label xml:lang="en">has experience level</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasGroup -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasGroup">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isGroupOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#OrganizationalUnit"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
        <rdfs:comment xml:lang="en">Relates an organizational unit to a group it contains.</rdfs:comment>
        <rdfs:label xml:lang="en">has group</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasGroupLocation -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasGroupLocation">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isLocatedAt"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Location"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
        <rdfs:comment xml:lang="en">Indicates the physical or virtual location associated with a group.</rdfs:comment>
        <rdfs:label xml:lang="en">has group location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasGroupStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasGroupStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesGroupEffect"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#GroupEffect"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#GroupStrategy"/>
        <rdfs:comment xml:lang="en">Relates a group-level effect to its corresponding corrective strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has group strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasIndividualStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasIndividualStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesIndividualEffect"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#IndividualEffect"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#IndividualStrategy"/>
        <rdfs:comment xml:lang="en">Relates an individual effect to its corrective strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has individual strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasMeasure -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasMeasure">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isResultOfMeasurement"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#MeasurementProcess"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Measure"/>
        <rdfs:comment xml:lang="en">Indicates the measurement context in which a measure is applied.</rdfs:comment>
        <rdfs:label xml:lang="en">hasMeasure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasMeasurement -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasMeasurement">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isMeasurementOfIndicator"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Indicator"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#MeasurementProcess"/>
        <rdfs:comment xml:lang="en">Relates an indicator to a measurement that evaluates it.</rdfs:comment>
        <rdfs:label xml:lang="en">has measurement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasMember -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasMember">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isMemberOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#Group"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Person"/>
        <rdfs:comment xml:lang="en">Links a group to the individuals that belong to it.</rdfs:comment>
        <rdfs:label xml:lang="en">has member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasPerson -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasPerson">
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#OrganizationalUnit"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Person"/>
        <rdfs:comment xml:lang="en">Links an organizational unit to a person within it.</rdfs:comment>
        <rdfs:label xml:lang="en">has person</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasProjectManagementStrategy -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasProjectManagementStrategy">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#mitigatesProjectManagementEffect"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#ProjectManagementEffect"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#ProjectManagementStrategy"/>
        <rdfs:comment xml:lang="en">Links a project management effect to its corrective strategy.</rdfs:comment>
        <rdfs:label xml:lang="en">has project management strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasRolePerformance -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasRolePerformance">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isRolePerformanceOf"/>
        <rdfs:domain rdf:resource="http://www.example.org/ontosocialdebt#PerformsRole"/>
        <rdfs:range rdf:resource="http://www.example.org/ontosocialdebt#Role"/>
        <rdfs:comment xml:lang="en">Associates a person with a role they perform in a project.</rdfs:comment>
        <rdfs:label xml:lang="en">has role performance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/ontosocialdebt#hasScaleType -->

    <owl:ObjectProperty rdf:about="http://www.example.org/ontosocialdebt#hasScaleType">
        <owl:inverseOf rdf:resource="http://www.example.org/ontosocialdebt#isTypeOfScale"/>
